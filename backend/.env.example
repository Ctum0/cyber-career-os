# Cyber Career OS - Environment Variables
#
# NOTE: Most settings are now configurable from the web UI at /settings.
# These env vars serve as fallback/override values. The UI settings take
# precedence when set. To configure via UI, visit http://localhost:3000/settings.
#
# AI Provider (configurable at /settings → AI Provider)
# The UI supports Groq, OpenAI, and any OpenAI-compatible endpoint.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.6-27b

# Obsidian vault sync (configurable at /settings → Obsidian Vault)
# Feature is off until OBSIDIAN_VAULT_PATH is set (via UI or here).
# OBSIDIAN_VAULT_PATH=/absolute/path/to/your/vault
# OBSIDIAN_SCAN_INTERVAL_MINUTES=30
# OBSIDIAN_INCLUDE_FOLDERS=cyber,career
# OBSIDIAN_EXCLUDE_FOLDERS=
# OBSIDIAN_REQUIRED_TAGS=cyber
# OBSIDIAN_ATTACHMENTS_DIR=
# OBSIDIAN_MAX_NOTES_PER_SCAN=10
# OBSIDIAN_MAX_IMAGES_PER_NOTE=5
# OBSIDIAN_MAX_IMAGE_SIZE=1024

# RSS Feeds (configurable at /settings → RSS Feeds)
# Managed via UI. Default feeds include TheHackersNews, Krebs, BleepingComputer, etc.

# Deferred: GitHub mirror source (not implemented yet)
# OBSIDIAN_REPO_URL=
# OBSIDIAN_GITHUB_TOKEN=
